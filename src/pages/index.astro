  <script>
    // @ts-nocheck
    (function () {
      const heroCta = document.querySelector('.hero-buttons .btn-primary');
      const mobileCta = document.querySelector('.mobile-cta');
      if (!heroCta || !mobileCta) return;
      const obs = new IntersectionObserver((entries) => {

      }
      .nav__links a { padding: 14px; border-radius: 12px; font-size: 16px; }
      .nav__drop { display: block; width: 100%; }
      .nav__drop-btn { width: 100%; justify-content: space-between; padding: 14px; border-radius: 12px; font-size: 16px; }
      .nav__drop-menu {

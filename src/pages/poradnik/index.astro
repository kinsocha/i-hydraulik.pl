---
import { getCollection } from "astro:content";
import PoradnikLayout from "../../layouts/PoradnikLayout.astro";

const articles = (await getCollection("poradnik"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatter = new Intl.DateTimeFormat("pl-PL", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});
---

<PoradnikLayout
  title="Poradnik hydrauliczny — i Hydraulik Warszawa"
  description="Praktyczne porady o przeciekach, awariach i udrażnianiu rur. Realne przypadki z naszych interwencji w Warszawie i okolicach."
>
  <section class="poradnik-archive">
    <div class="container">
      <div class="poradnik-archive__head">
        <p class="section-kicker">Poradnik</p>
        <h1>Porady i realne przypadki z naszych interwencji</h1>
      </div>

      <div class="awarie-baner">
        <div class="awarie-baner__text">
          <span class="awarie-baner__kicker">Szukasz po objawie?</span>
          <h2><a href="/poradnik/awarie-hydrauliczne-woda-kanalizacja-co">Awarie hydrauliczne: woda, kanalizacja, centralne ogrzewanie</a></h2>
          <p>Przyczyny, przebieg i skutki awarii zależne od budynku i piętra. Przypadki z 20 lat pracy hydraulika.</p>
        </div>
        <a class="awarie-baner__btn" href="/poradnik/awarie-hydrauliczne-woda-kanalizacja-co" title="Awarie hydrauliczne: woda, kanalizacja, centralne ogrzewanie">Zobacz awarie →</a>
      </div>

      <div class="blog-grid">
        {
          articles.map((article) => (
            <article class="blog-card">
              <a class="blog-card__media" href={`/poradnik/${article.slug}`}>
                <img
                  src={article.data.hero}
                  alt={article.data.heroAlt}
                  width="400"
                  height="225"
                  loading="lazy"
                />
              </a>
              <div class="blog-card__body">
                <span class="blog-tag">{article.data.category}</span>
                <h3>
                  <a href={`/poradnik/${article.slug}`}>{article.data.title}</a>
                </h3>
                <p class="blog-card__excerpt">{article.data.description}</p>
                <div class="blog-meta">
                  <span>📅 {formatter.format(article.data.pubDate)}</span>
                  <span>⏱ {article.data.readingTime} min</span>
                </div>
                <a class="blog-card__more" href={`/poradnik/${article.slug}`}>
                  Czytaj więcej →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</PoradnikLayout>

---
import { getCollection, type CollectionEntry } from "astro:content";
import PoradnikLayout from "../../layouts/PoradnikLayout.astro";

export async function getStaticPaths() {
  return (await getCollection("poradnik"))
    .map((post) => ({ params: { slug: post.slug }, props: post }));
}

type Props = CollectionEntry<"poradnik">;
const post = Astro.props;
const { Content } = await post.render();

const formatter = new Intl.DateTimeFormat("pl-PL", {
  day: "2-digit",
  month: "long",
  year: "numeric",
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.heroTitle,
  description: post.data.description,
  image: `https://i-hydraulik.pl${post.data.hero}`,
  author: { "@type": "Organization", name: post.data.author },
  publisher: {
    "@type": "Organization",
    name: "i Hydraulik",
    logo: {
      "@type": "ImageObject",
      url: "https://i-hydraulik.pl/favicon.svg",
    },
  },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
};

const faq = post.data.faq ?? [];
const faqLd = faq.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    }
  : null;
---

<PoradnikLayout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  {faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />}

  <div class="article-wrap">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ścieżka">
        <a href="/">Start</a> <span>/</span>
        <a href="/poradnik">Poradnik</a> <span>/</span>
        <span>{post.data.title}</span>
      </nav>

      <article class="article">
        <span class="article__tag">{post.data.category}</span>
        <h1>{post.data.heroTitle}</h1>
        <p class="article__lead">{post.data.heroLead}</p>
        <div class="article__meta">
          <span>Autor: {post.data.author}</span>
          <span>📅 {formatter.format(post.data.pubDate)}</span>
          <span>⏱ {post.data.readingTime} min czytania</span>
        </div>

        <figure class="article__hero">
          <img src={post.data.hero} alt={post.data.heroAlt} width="1200" height="675" />
        </figure>

        <div class="article__content">
          <Content />
        </div>

        {faq.length > 0 && (
          <section class="article__faq" aria-label="Najczęstsze pytania">
            <h2>Najczęściej zadawane pytania</h2>
            {faq.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <div class="faq-item__a"><p>{item.a}</p></div>
              </details>
            ))}
          </section>
        )}

        <div class="article__cta">
          <div>
            <strong>Masz podobny problem? Zadzwoń: 511 323 123</strong>
            <span>Hydraulik Warszawa i okolice — diagnoza i naprawa bez zbędnego kucia.</span>
          </div>
          <a class="btn-new btn-new--primary" href="tel:+48511323123">📞 Zadzwoń teraz</a>
        </div>
      </article>
    </div>
  </div>

  <style is:global>
    .article__content img {
      max-width: 100%;
      height: auto;
      border-radius: 18px;
      display: block;
      margin: 28px 0;
    }
    .article-gallery {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin: 24px 0 8px;
    }
    .article-gallery__item {
      display: block;
      overflow: hidden;
      border-radius: 18px;
      box-shadow: 0 12px 40px rgba(22, 27, 53, 0.08);
      aspect-ratio: 4 / 3;
    }
    .article-gallery__item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      margin: 0;
      border-radius: 0;
      transition: transform 0.4s ease;
    }
    .article-gallery__item:hover img {
      transform: scale(1.05);
    }
    @media (max-width: 640px) {
      .article-gallery {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }
    }
    .tabela-zgrzew-wrap { overflow-x: auto; margin: 24px 0; }
    .tabela-zgrzew {
      width: 100%; border-collapse: collapse; font-size: 16px; color: #3b4152;
      border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-soft);
      border: 1px solid var(--line);
    }
    .tabela-zgrzew caption {
      caption-side: top; text-align: left; font-size: 14px; color: var(--muted);
      padding: 0 0 10px; font-style: italic;
    }
    .tabela-zgrzew thead th {
      background: linear-gradient(135deg, #171a33, #23264a);
      color: #fff; font-weight: 700;
      text-align: left; padding: 14px 18px; border: none;
    }
    .tabela-zgrzew tbody th, .tabela-zgrzew tbody td {
      padding: 12px 18px; border: none; text-align: left;
    }
    .tabela-zgrzew tbody tr:nth-child(odd) { background: rgba(255,255,255,0.85); }
    .tabela-zgrzew tbody tr:nth-child(even) { background: var(--orange-soft); }
    .tabela-zgrzew tbody th { font-weight: 800; color: var(--ink); }
    .tabela-zgrzew .nagrzew { font-weight: 800; color: #c85500; }
  </style>
</PoradnikLayout>

  <style>
    @property --border-angle {
      syntax: "<angle>";
      inherits: false;
      initial-value: 0deg;
    }

    :root {
      --card: rgba(255,255,255,0.82);
      --ink: #181b35;
      --muted: #6e7482;
      --muted-2: #8a909d;
      --blue: #1f6fd1;
      --blue-dark: #154f9c;
      --blue-soft: #eaf2ff;
      --orange: #ff740f;
      --orange-soft: #fff1e6;
      --cream: #efe5db;
      --line: #e7ded5;
      --shadow: 0 24px 70px rgba(22,27,53,0.10);
      --shadow-soft: 0 12px 40px rgba(22,27,53,0.08);
      --radius-xl: 34px;
      --radius-lg: 24px;
      --radius-md: 18px;
      --container: 1180px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--ink);
      background: #FDF8F3;
      overflow-x: hidden;
    }

    body[data-bg="premium"],
    body[data-bg="water"],
    body[data-bg="warm"],
    body[data-bg="silver"] { background: #FDF8F3; }

    a { color: inherit; text-decoration: none; }

    .page-shell { min-height: 100vh; position: relative; isolation: isolate; }
    .container { width: min(var(--container), calc(100% - 40px)); margin: 0 auto; }

    /* BG SWITCHER */
    .bg-switcher {
      position: fixed; right: 22px; top: 96px; z-index: 90;
      display: flex; gap: 8px; padding: 8px; border-radius: 999px;
      background: rgba(255,255,255,0.72); border: 1px solid rgba(231,222,213,0.88);
      box-shadow: 0 16px 42px rgba(22,27,53,0.10); backdrop-filter: blur(16px);
    }
    .bg-switcher button {
      border: 0; min-height: 34px; padding: 0 12px; border-radius: 999px;
      background: transparent; color: #4d5565; cursor: pointer;
      font: inherit; font-size: 12px; font-weight: 900;
      transition: background 0.25s, color 0.25s, transform 0.25s;
    }
    .bg-switcher button:hover, .bg-switcher button.is-active {
      background: var(--blue); color: #fff; transform: translateY(-1px);
    }

    /* TOPBAR */
    .topbar {
      position: sticky; top: 0; z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(255,255,255,0.92);
      border-bottom: 1px solid rgba(220,220,220,0.72);
    }
    .nav {
      min-height: 78px; display: flex; align-items: center;
      justify-content: space-between; gap: 24px;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 8px;
      font-weight: 900; letter-spacing: -0.04em; font-size: 24px; color: var(--blue);
    }
    .logo__i {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic; font-weight: 300;
      font-size: 30px; letter-spacing: 0.02em;
    }
    .logo__name {
      font-weight: 900; letter-spacing: -0.04em; font-size: 24px;
    }
    .logo__mark {
      width: 42px; height: 42px; border-radius: 15px;
      display: grid; place-items: center; color: #fff;
      background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.35), transparent 30%),
                  linear-gradient(135deg, var(--blue), var(--blue-dark));
      box-shadow: 0 12px 28px rgba(31,111,209,0.24);
    }
    .nav__links {
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .nav__links a {
      padding: 12px 14px; border-radius: 999px; color: #22243c;
      font-size: 15px; font-weight: 650;
      transition: background 0.25s, color 0.25s, transform 0.25s;
    }
    .nav__links a:hover {
      background: rgba(31,111,209,0.08); color: var(--blue); transform: translateY(-1px);
    }

    /* DROPDOWN — Dzielnice */
    .nav__drop { position: relative; display: inline-flex; }
    .nav__drop-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 12px 14px; border: 0; border-radius: 999px; background: transparent;
      color: #22243c; font: inherit; font-size: 15px; font-weight: 650; cursor: pointer;
      transition: background 0.25s, color 0.25s, transform 0.25s;
    }
    .nav__drop-btn:hover { background: rgba(31,111,209,0.08); color: var(--blue); transform: translateY(-1px); }
    .nav__drop-caret { font-size: 11px; transition: transform 0.25s; }
    .nav__drop:hover .nav__drop-caret,
    .nav__drop.is-open .nav__drop-caret { transform: rotate(180deg); }
    .nav__drop-menu {
      position: absolute; top: calc(100% + 8px); left: 0; z-index: 60;
      display: flex; flex-direction: column; gap: 2px; min-width: 210px; padding: 8px;
      background: rgba(255,255,255,0.98); border: 1px solid rgba(220,220,220,0.72);
      border-radius: 16px; box-shadow: 0 22px 50px rgba(22,27,53,0.14);
      opacity: 0; visibility: hidden; transform: translateY(-8px); pointer-events: none;
      transition: opacity 0.25s, transform 0.25s, visibility 0.25s;
    }
    .nav__drop:hover .nav__drop-menu,
    .nav__drop:focus-within .nav__drop-menu,
    .nav__drop.is-open .nav__drop-menu {
      opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto;
    }
    .nav__drop-menu a {
      padding: 10px 14px; border-radius: 12px; color: #22243c;
      font-size: 15px; font-weight: 650; white-space: nowrap;
    }
    .nav__drop-menu a:hover { background: rgba(31,111,209,0.08); color: var(--blue); }
    .nav__actions { display: flex; align-items: center; gap: 14px; }
    .phone-link {
      display: inline-flex; align-items: center; gap: 8px;
      font-weight: 800; color: #20233a; white-space: nowrap;
    }
    .phone-link span { color: #e64b8e; }

    /* HAMBURGER (menu toggle — wzorzec efferd / 21st.dev) */
    .hamburger {
      display: none; align-items: center; justify-content: center;
      width: 46px; height: 46px; padding: 0; border: 0; border-radius: 14px;
      background: transparent; color: var(--ink); cursor: pointer; line-height: 0;
      transition: background 0.25s, color 0.25s;
    }
    .hamburger:hover { background: rgba(31,111,209,0.08); color: var(--blue); }
    .hamburger svg { width: 30px; height: 30px; transition: transform 0.5s ease-in-out; }
    .hamburger svg .ham-morph {
      stroke-dasharray: 12 63;
      transition: stroke-dasharray 0.5s ease-in-out, stroke-dashoffset 0.5s ease-in-out;
    }
    .hamburger.is-open svg { transform: rotate(-45deg); }
    .hamburger.is-open svg .ham-morph { stroke-dasharray: 20 300; stroke-dashoffset: -32.42px; }

    /* BUTTONS (new sections) */
    .btn-new {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 9px; min-height: 50px; padding: 0 22px; border-radius: 999px;
      border: 1px solid transparent; font-weight: 850; cursor: pointer;
      transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
    }
    .btn-new--primary {
      color: #fff;
      background: radial-gradient(circle at 30% 10%, rgba(255,255,255,0.32), transparent 28%),
                  linear-gradient(135deg, #ff8a1f, #ff5f00);
      box-shadow: 0 16px 36px rgba(255,116,15,0.28);
    }
    .btn-new--primary:hover { transform: translateY(-2px); box-shadow: 0 20px 44px rgba(255,116,15,0.34); }
    .btn-new--ghost {
      color: var(--ink); background: rgba(255,255,255,0.52);
      border-color: rgba(24,27,53,0.18);
    }
    .btn-new--ghost:hover {
      transform: translateY(-2px); background: #fff;
      border-color: rgba(31,111,209,0.22); box-shadow: var(--shadow-soft);
    }

    /* SECTIONS */
    .new-section { padding: 72px 0; }

    .section-head {
      display: flex; align-items: end; justify-content: space-between;
      gap: 24px; margin-bottom: 30px;
    }
    .section-kicker {
      margin: 0 0 10px; color: var(--orange); font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px;
    }
    .section-title {
      margin: 0; font-size: clamp(32px,4vw,52px);
      letter-spacing: -0.01em; line-height: 1.15; max-width: 720px;
    }
    .price-note {
      margin: 24px 0 0; color: var(--muted); font-size: 14px;
      line-height: 1.65; max-width: 680px;
      padding-left: 18px; border-left: 2px solid var(--border);
    }
    .section-desc {
      margin: 0; color: var(--muted); line-height: 1.7;
      max-width: 430px; font-size: 16px;
    }

    /* SERVICE GRID */
    .service-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }

    .service-card-new {
      min-height: 280px; padding: 26px;
      border-radius: var(--radius-lg); background: var(--card);
      border: 1px solid rgba(231,222,213,0.88);
      box-shadow: 0 16px 54px rgba(22,27,53,0.055);
      position: relative; overflow: hidden; isolation: isolate;
      transition: transform 0.28s, box-shadow 0.28s, background 0.28s, border-color 0.28s;
    }
    .service-card-new::before {
      content: ""; position: absolute; inset: 0;
      border-radius: inherit; padding: 1.4px;
      background: conic-gradient(
        from var(--border-angle), transparent 0deg, transparent 140deg,
        rgba(31,111,209,0.42) 190deg, rgba(255,116,15,0.36) 235deg,
        rgba(231,222,213,0.58) 290deg, transparent 360deg
      );
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      mask-composite: exclude;
      opacity: 0; pointer-events: none; z-index: -1;
      transition: opacity 0.3s;
    }
    .service-card-new:hover {
      transform: translateY(-7px); background: rgba(255,255,255,0.94);
      border-color: transparent; box-shadow: 0 24px 70px rgba(22,27,53,0.10);
    }
    .service-card-new:hover::before { opacity: 1; animation: borderSpin 4.2s linear infinite; }
    @keyframes borderSpin { to { --border-angle: 360deg; } }

    .service-card-new__icon {
      width: 64px; height: 64px; border-radius: 20px;
      display: grid; place-items: center; margin-bottom: 24px;
      font-size: 30px; overflow: hidden;
      background: linear-gradient(135deg, var(--blue-soft), #f6f8fc);
      box-shadow: inset 0 0 0 1px rgba(31,111,209,0.08), 0 14px 30px rgba(22,27,53,0.06);
      transition: transform 0.3s;
    }
    .service-card-new:hover .service-card-new__icon { transform: scale(1.06) rotate(-2deg); }
    .service-card-new__icon img { width: 100%; height: 100%; object-fit: contain; }

    .service-card-new h3 { margin: 0 0 12px; font-size: 24px; letter-spacing: -0.04em; }
    .service-card-new p { margin: 0; color: var(--muted); line-height: 1.65; }
    .service-card-new__more {
      display: inline-flex; align-items: center; gap: 8px;
      margin-top: 22px; color: var(--blue); font-weight: 900;
    }

    /* BENTO / PROCESS */
    .bento { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 18px; }
    .panel {
      border-radius: var(--radius-xl); border: 1px solid rgba(231,222,213,0.9);
      background: rgba(255,255,255,0.72); box-shadow: var(--shadow-soft); overflow: hidden;
    }
    .diagnostic { padding: 36px; position: relative; min-height: 420px; }
    .diagnostic h2, .process-panel h2 {
      margin: 0 0 16px; font-size: clamp(30px,3vw,44px);
      line-height: 1.15; letter-spacing: -0.01em;
    }
    .diagnostic p { color: var(--muted); line-height: 1.75; font-size: 17px; max-width: 640px; }

    .check-list { display: grid; gap: 13px; margin: 28px 0 0; padding: 0; list-style: none; }
    .check-list li {
      display: flex; align-items: flex-start; gap: 12px;
      color: #33384b; font-weight: 700;
    }
    .check-list li::before {
      content: "✓"; width: 24px; height: 24px; flex: 0 0 24px;
      border-radius: 50%; display: grid; place-items: center;
      color: #fff; background: var(--blue); font-size: 13px; margin-top: 1px;
    }

    .process-panel { padding: 30px; display: grid; gap: 15px; }

    /* PROCESS STEPS — scoped to .panel to avoid conflict with phone mockup .step */
    .panel .step {
      position: relative; padding: 20px 20px 20px 72px;
      border-radius: 22px; background: #fff;
      border: 1px solid rgba(231,222,213,0.72);
      transition: transform 0.25s, border-color 0.25s;
    }
    .panel .step:hover { transform: translateX(5px); border-color: rgba(31,111,209,0.18); }
    .panel .step__num {
      position: absolute; left: 18px; top: 18px;
      width: 38px; height: 38px; border-radius: 14px;
      display: grid; place-items: center; color: #fff; font-weight: 900;
      background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    }
    .panel .step strong { display: block; margin-bottom: 6px; font-size: 17px; }
    .panel .step span { color: var(--muted); line-height: 1.55; font-size: 14px; }

    /* PRICING */
    .pricing-section { padding: 72px 0 84px; }
    .price-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; margin-top: 28px; }
    .price-card {
      padding: 28px; border-radius: var(--radius-lg); background: #fff;
      border: 1px solid rgba(231,222,213,0.9);
      box-shadow: 0 15px 44px rgba(22,27,53,0.06);
      transition: transform 0.28s, box-shadow 0.28s;
    }
    .price-card:hover { transform: translateY(-6px); box-shadow: 0 25px 68px rgba(22,27,53,0.11); }
    .price-card--featured {
      color: #fff;
      background: linear-gradient(135deg, var(--blue), #174f99);
      border-color: rgba(255,255,255,0.3);
    }
    .price-card__tag {
      display: inline-flex; padding: 8px 11px; border-radius: 999px;
      font-size: 12px; font-weight: 900; color: var(--blue); background: var(--blue-soft);
    }
    .price-card--featured .price-card__tag { color: var(--ink); background: #fff; }
    .price-card h3 { margin: 22px 0 10px; font-size: 23px; letter-spacing: -0.04em; }
    .price-card p { min-height: 78px; margin: 0; color: var(--muted); line-height: 1.6; }
    .price-card--featured p { color: rgba(255,255,255,0.78); }
    .price-val {
      display: flex; align-items: baseline; gap: 7px; margin-top: 22px;
      font-weight: 900; letter-spacing: -0.05em; font-size: 34px;
    }
    .price-val small { color: var(--muted-2); font-size: 14px; letter-spacing: 0; font-weight: 800; }
    .price-card--featured .price-val small { color: rgba(255,255,255,0.72); }

    /* TESTIMONIAL */
    .testimonial-strip { margin: 4px 0 76px; }
    .strip-card {
      display: grid; grid-template-columns: 0.8fr 1.2fr;
      align-items: center; gap: 34px; padding: 34px;
      border-radius: var(--radius-xl); background: rgba(255,255,255,0.74);
      border: 1px solid rgba(231,222,213,0.9); box-shadow: var(--shadow-soft);
    }
    .rating {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 12px 14px; border-radius: 999px;
      background: var(--orange-soft); color: var(--orange); font-weight: 950;
    }
    blockquote {
      margin: 0; color: #34384a; font-size: clamp(22px,3vw,34px);
      line-height: 1.25; letter-spacing: -0.045em; font-weight: 850;
    }

    /* FAQ */
    .faq-section { padding: 72px 0; }
    .faq-grid { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: 28px; align-items: start; }
    .faq-list { display: grid; gap: 12px; }
    .faq-item {
      border-radius: 22px; background: rgba(255,255,255,0.78);
      border: 1px solid rgba(231,222,213,0.86); overflow: hidden;
    }
    .faq-question {
      width: 100%; display: flex; align-items: center;
      justify-content: space-between; gap: 18px; padding: 20px 22px;
      border: 0; background: transparent; cursor: pointer; color: var(--ink);
      text-align: left; font: inherit; font-weight: 850; font-size: 17px;
    }
    .faq-question span:last-child {
      width: 32px; height: 32px; flex: 0 0 32px;
      display: grid; place-items: center; border-radius: 50%;
      color: var(--blue); background: var(--blue-soft); transition: transform 0.25s;
    }
    .faq-answer { max-height: 0; overflow: hidden; transition: max-height 0.32s; }
    .faq-answer p { margin: 0; padding: 0 22px 22px; color: var(--muted); line-height: 1.7; }
    .faq-item.is-open .faq-answer { max-height: 200px; }
    .faq-item.is-open .faq-question span:last-child {
      transform: rotate(45deg); color: var(--orange); background: var(--orange-soft);
    }

    /* CTA SECTION */
    .cta-section { padding: 84px 0 96px; }
    .final-cta {
      position: relative; overflow: hidden; border-radius: 42px; padding: 50px;
      color: #fff;
      background: linear-gradient(135deg, #171a33, #102f62 68%, #1f6fd1 120%);
      box-shadow: 0 30px 90px rgba(22,27,53,0.22);
    }
    .final-cta::before {
      content: ""; position: absolute; inset: 20px; border-radius: 32px;
      border: 1px solid rgba(255,255,255,0.14); pointer-events: none;
    }
    .final-cta__content {
      position: relative; z-index: 1;

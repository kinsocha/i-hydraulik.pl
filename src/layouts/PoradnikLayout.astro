---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Poradnik hydrauliczny — i Hydraulik Warszawa" } = Astro.props;

// canonical bez kreski na końcu (poza rootem)
const cleanPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = `https://i-hydraulik.pl${cleanPath}`;
---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,300;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/poradnik.css" />

  <style>
    :root {
      --card: rgba(255,255,255,0.86);
      --ink: #181b35;
      --muted: #6e7482;
      --muted-2: #8a909d;
      --blue: #1f6fd1;
      --blue-dark: #154f9c;
      --blue-soft: #eaf2ff;
      --orange: #ff740f;
      --orange-soft: #fff1e6;
      --line: #e7ded5;
      --shadow-soft: 0 12px 40px rgba(22,27,53,0.08);
      --radius-lg: 24px;
      --radius-md: 18px;
      --container: 1180px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--ink);
      background: #FDF8F3;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }

    .page-shell { min-height: 100vh; display: flex; flex-direction: column; }
    .container { width: min(var(--container), calc(100% - 40px)); margin: 0 auto; }

    /* TOPBAR */
    .topbar {
      position: sticky; top: 0; z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(255,255,255,0.92);
      border-bottom: 1px solid rgba(220,220,220,0.72);
    }
    .nav {
      min-height: 78px; display: flex; align-items: center;
      justify-content: space-between; gap: 24px;
    }
    .logo {
      display: inline-flex; align-items: center; gap: 8px;
      font-weight: 900; letter-spacing: -0.04em; font-size: 24px; color: var(--blue);
    }
    .logo__i {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic; font-weight: 300;
      font-size: 30px; letter-spacing: 0.02em;
    }
    .logo__name { font-weight: 900; letter-spacing: -0.04em; font-size: 24px; }
    .logo__mark {
      width: 42px; height: 42px; border-radius: 15px;
      display: grid; place-items: center; color: #fff;
      background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.35), transparent 30%),
                  linear-gradient(135deg, var(--blue), var(--blue-dark));
      box-shadow: 0 12px 28px rgba(31,111,209,0.24);
    }
    .nav__links { display: flex; align-items: center; justify-content: center; gap: 8px; }
    .nav__links a {
      padding: 12px 14px; border-radius: 999px; color: #22243c;
      font-size: 15px; font-weight: 650;
      transition: background 0.25s, color 0.25s, transform 0.25s;
    }
    .nav__links a:hover {
      background: rgba(31,111,209,0.08); color: var(--blue); transform: translateY(-1px);
    }
    .nav__actions { display: flex; align-items: center; gap: 14px; }
    .phone-link {
      display: inline-flex; align-items: center; gap: 8px;
      font-weight: 800; color: #20233a; white-space: nowrap;
    }
    .phone-link span { color: #e64b8e; }

    .hamburger {
      display: none; align-items: center; justify-content: center;
      width: 46px; height: 46px; padding: 0; border: 0; border-radius: 14px;
      background: transparent; color: var(--ink); cursor: pointer; line-height: 0;
      transition: background 0.25s, color 0.25s;
    }
    .hamburger:hover { background: rgba(31,111,209,0.08); color: var(--blue); }
    .hamburger svg { width: 30px; height: 30px; transition: transform 0.5s ease-in-out; }
    .hamburger svg .ham-morph {
      stroke-dasharray: 12 63;
      transition: stroke-dasharray 0.5s ease-in-out, stroke-dashoffset 0.5s ease-in-out;
    }
    .hamburger.is-open svg { transform: rotate(-45deg); }
    .hamburger.is-open svg .ham-morph { stroke-dasharray: 20 300; stroke-dashoffset: -32.42px; }

    /* BUTTONS */
    .btn-new {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 9px; min-height: 50px; padding: 0 22px; border-radius: 999px;
      border: 1px solid transparent; font-weight: 850; cursor: pointer;
      transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
    }
    .btn-new--primary {
      color: #fff;
      background: radial-gradient(circle at 30% 10%, rgba(255,255,255,0.32), transparent 28%),
                  linear-gradient(135deg, #ff8a1f, #ff5f00);
      box-shadow: 0 16px 36px rgba(255,116,15,0.28);
    }
    .btn-new--primary:hover { transform: translateY(-2px); box-shadow: 0 20px 44px rgba(255,116,15,0.34); }
    .btn-new--ghost {
      color: var(--ink); background: rgba(255,255,255,0.62);
      border-color: rgba(24,27,53,0.18);
    }
    .btn-new--ghost:hover {
      transform: translateY(-2px); background: #fff;
      border-color: rgba(31,111,209,0.22); box-shadow: var(--shadow-soft);
    }

    main { flex: 1; }

    /* sekcja nagłówkowa (kicker) — spójna z home */
    .section-kicker {
      margin: 0 0 10px; color: var(--orange); font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px;
    }

    /* FOOTER */
    .new-footer {
      padding: 28px 0 38px; color: var(--muted);
      border-top: 1px solid rgba(231,222,213,0.9);
    }
    .footer-grid {
      display: flex; align-items: center; justify-content: space-between;
      gap: 18px; flex-wrap: wrap;
    }

    .mobile-cta {
      display: none; position: fixed; left: 16px; right: 16px; bottom: 16px;
      z-index: 70; min-height: 58px; border-radius: 999px; color: #fff;
      background: linear-gradient(135deg, #ff8a1f, #ff5f00);
      box-shadow: 0 18px 44px rgba(255,116,15,0.30);
      align-items: center; justify-content: center; font-weight: 950;
    }

    @media (max-width: 980px) {
      .hamburger { display: inline-flex; }
      .nav__links {
        position: absolute; top: 100%; left: 0; right: 0;
        flex-direction: column; align-items: stretch; gap: 4px;
        padding: 14px 20px 22px; margin: 0;
        background: rgba(255,255,255,0.98);
        border-bottom: 1px solid rgba(220,220,220,0.72);
        box-shadow: 0 26px 50px rgba(22,27,53,0.14);
        transform: translateY(-14px); opacity: 0; visibility: hidden; pointer-events: none;
        transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s;
      }
      .nav__links a { padding: 14px; border-radius: 12px; font-size: 16px; }
      .nav__links.is-open { opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0); }
    }
    @media (max-width: 640px) {
      .container { width: min(100% - 28px, var(--container)); }
      .phone-link, .nav__actions .btn-new { display: none; }
      .logo { font-size: 22px; }
      .mobile-cta { display: flex; }
      .new-footer { padding-bottom: 92px; }
    }
  </style>
</head>

<body>
  <div class="page-shell">
    <header class="topbar">
      <div class="container nav">
        <a href="/" class="logo" aria-label="i Hydraulik strona główna">
          <span class="logo__mark">🔧</span>
          <span class="logo__i">i</span><span class="logo__name">Hydraulik</span>
        </a>
        <nav class="nav__links" id="primary-nav" aria-label="Główna nawigacja">
          <a href="/#uslugi">Usługi</a>
          <a href="/#proces">Jak działamy</a>
          <a href="/#cennik">Cennik</a>
          <a href="/poradnik">Poradnik</a>
          <a href="/#faq">FAQ</a>
          <a href="/#kontakt">Kontakt</a>
        </nav>
        <div class="nav__actions">
          <a class="phone-link" href="tel:+48511323123"><span>☎</span> 511 323 123</a>
          <a class="btn-new btn-new--primary" href="tel:+48511323123">Zadzwoń teraz</a>
          <button class="hamburger" type="button" aria-label="Otwórz menu" aria-expanded="false" aria-controls="primary-nav">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path class="ham-morph" d="M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22" />
              <path d="M7 16 27 16" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="new-footer">
      <div class="container footer-grid">
        <div>2006 i Hydraulik — Hydraulik Warszawa</div>
        <div>Udrażnianie rur • WUKO • Kamera • Piony kanalizacyjne</div>
      </div>
    </footer>

    <a class="mobile-cta" href="tel:+48511323123">📞 Zadzwoń: 511 323 123</a>
  </div>

  <script>
    // @ts-nocheck
    const ham = document.querySelector('.hamburger');
    const links = document.getElementById('primary-nav');
    if (ham && links) {
      ham.addEventListener('click', () => {
        const open = ham.classList.toggle('is-open');
        links.classList.toggle('is-open', open);
        ham.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      links.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => {
          ham.classList.remove('is-open');
          links.classList.remove('is-open');
          ham.setAttribute('aria-expanded', 'false');
        })
      );
    }
  </script>
</body>
</html>

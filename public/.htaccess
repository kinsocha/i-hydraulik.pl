# Czyste adresy bez kreski na końcu (i-hydraulik.pl)
# Astro buduje strony jako /sciezka/index.html. Domyślnie Apache dokleja
# kreskę (/sciezka -> /sciezka/). Poniższe reguły wymuszają wersję BEZ kreski.

Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On

# 00) www -> bez www (jednym skokiem; https wymusza już serwer)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 0) Stałe przekierowania 301 (stare adresy artykułów)
RewriteRule ^poradnik/deski-sedesowa-ktora-rusza-sie-bielany/?$ /poradnik/naprawa-ruszajacej-sie-deski-sedesowej [R=301,L]
RewriteRule ^poradnik/montaz-pralki-bialoleka/?$ /poradnik/montaz-pralki-w-nowym-mieszkaniu [R=301,L]
RewriteRule ^nowyx/?$ / [R=301,L]

# 1) Przekieruj adres z kreską na końcu na wersję bez kreski (poza rootem)
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 1a) /index.html i /sciezka/index.html -> 301 jednym skokiem na adres kanoniczny.
#     Bez tego każda strona istniała pod dwoma adresami z kodem 200
#     (GSC 09.2026: "Duplikat, Google wybrała inną stronę kanoniczną").
#     THE_REQUEST = to, co wpisał klient; wewnętrzny rewrite z 2) tej reguły nie odpala (brak pętli).
RewriteCond %{THE_REQUEST} \s/+([^?\s]*/)?index\.html[?\s] [NC]
RewriteRule ^(.*?)/?index\.html$ /$1 [R=301,L]

# 2) Serwuj /sciezka/index.html dla adresu /sciezka (bez przekierowania)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*?)/?$ $1/index.html [L]
